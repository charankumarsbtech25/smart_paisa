# SmartPaisa 2.0 Environment Configuration Template
# Copy this file to `.env` for local development or configure in Vercel / Hosting settings.

# 1. Frontend Public Variables (Safe for Browser)
# Optional for local testing — if omitted, SmartPaisa runs in full-featured Demo Mode using localStorage.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_ML_SERVICE_URL=http://localhost:8000

# 2. Server-Side Secrets ONLY (Set in Supabase Edge Function Secrets — NEVER prefix with VITE_)
# Run: `supabase secrets set OPENAI_API_KEY=sk-... OPENAI_MODEL=gpt-4o-mini`
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 3. Optional FastAPI ML Service Shared Secret (Set in ml_service environment)
# SMARTPAISA_ML_API_SECRET=your-shared-secret
